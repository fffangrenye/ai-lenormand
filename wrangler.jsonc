{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flora",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://flora.floralenormand.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
