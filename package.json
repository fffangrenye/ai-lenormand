{
  "name": "soul-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:patch": "node scripts/patch-next-cloudflare-windows.cjs",
    "cf:build": "npm run cf:patch && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:build:secure": "node scripts/secure-cloudflare-build.cjs",
    "cf:scan-artifacts": "node scripts/scan-cloudflare-artifacts.cjs",
    "cf:preview": "npm run cf:patch && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:patch && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "cf:deploy:redirect:ai-lenormand": "wrangler deploy --config wrangler.redirect-ai-lenormand.jsonc",
    "cf:deploy:redirect:preview": "wrangler deploy --config wrangler.redirect-preview.jsonc",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "4.129.0"
  }
}
