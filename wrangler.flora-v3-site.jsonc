{
  "name":"flora-domain-info",
  "account_id":"ba9ee3a5752bb83f8bb97f3b60dfa88b",
  "main":"workers/flora-site/entry.ts",
  "compatibility_date":"2026-09-04",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":false,
  "preview_urls":false,
  "assets":{"directory":".open-next/assets","binding":"ASSETS","run_worker_first":false,"html_handling":"drop-trailing-slash","not_found_handling":"none"},
  "ratelimits":[
    {"name":"API_TRAFFIC","namespace_id":"2026102201","simple":{"limit":600,"period":60}},
    {"name":"RECOVERY_TRAFFIC","namespace_id":"2026102202","simple":{"limit":10,"period":60}}
  ],
  "services":[{"binding":"FLORA_API","service":"flora-v3-api"}],
  "routes":[{"pattern":"floralenormand.site","custom_domain":true},{"pattern":"www.floralenormand.site","custom_domain":true}],
  "vars":{"NEXT_PUBLIC_SITE_URL":"https://floralenormand.site","NEXT_PUBLIC_PAID_ONLINE_MODE":"1"},
  "observability":{"enabled":true}
}
